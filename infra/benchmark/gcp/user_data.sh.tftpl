#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl mdadm nvme-cli sysstat

mkdir -p /opt/craq-bench/bin /etc/craq-bench /var/lib/craq-bench
chown -R ${ssh_user}:${ssh_user} /opt/craq-bench /etc/craq-bench /var/lib/craq-bench

if [ "${role}" = "storage" ]; then
  mkdir -p /var/lib/craq-bench/storage-data

  mapfile -t DATA_DEVS < <(find /dev/disk/by-id -maxdepth 1 -type l -name 'google-local-ssd-*' | sort)
  if [ "$${#DATA_DEVS[@]}" -gt 0 ]; then
    DEVICES=()
    for link in "$${DATA_DEVS[@]}"; do
      DEVICES+=("$(readlink -f "$${link}")")
    done

    ARRAY_DEV="/dev/md/craq-bench-storage"
    if [ ! -e "$${ARRAY_DEV}" ]; then
      yes | mdadm --create "$${ARRAY_DEV}" --level=0 --raid-devices="$${#DEVICES[@]}" "$${DEVICES[@]}"
    fi

    udevadm settle
    if ! blkid "$${ARRAY_DEV}" >/dev/null 2>&1; then
      mkfs.ext4 -F "$${ARRAY_DEV}"
    fi
    grep -q "$${ARRAY_DEV} /var/lib/craq-bench/storage-data" /etc/fstab || echo "$${ARRAY_DEV} /var/lib/craq-bench/storage-data ext4 defaults,nofail 0 2" >> /etc/fstab
    mount /var/lib/craq-bench/storage-data || mount -a
    mkdir -p /var/lib/craq-bench/storage-data/storage
    chown -R ${ssh_user}:${ssh_user} /var/lib/craq-bench/storage-data
  fi
fi
